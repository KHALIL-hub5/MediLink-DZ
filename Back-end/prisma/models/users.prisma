model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  email                      String                     @unique @db.VarChar(255)
  passwordHash               String                     @map("password_hash") @db.VarChar(255)
  firstName                  String?                    @map("first_name") @db.VarChar(100)
  lastName                   String?                    @map("last_name") @db.VarChar(100)
  phone                      String?                    @unique @db.VarChar(30)
  avatarUrl                  String?                    @map("avatar_url") @db.VarChar(500)
  role                       UserRole                   @default(PATIENT)
  status                     UserStatus                 @default(PENDING_VERIFICATION)
  failedLoginAttempts        Int                        @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime?                  @map("locked_until")
  deactivatedAt              DateTime?                  @map("deactivated_at")
  deactivationSource         AccountDeactivationSource? @map("deactivation_source")
  deletionRequestedAt        DateTime?                  @map("deletion_requested_at")
  deletedAt                  DateTime?                  @map("deleted_at")
  emailVerifiedAt            DateTime?                  @map("email_verified_at")
  emailVerificationToken     String?                    @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiresAt DateTime?                  @map("email_verification_expires_at")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  passwordResetToken         String?                    @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiresAt     DateTime?                  @map("password_reset_expires_at")

  patient                     Patient?
  doctor                      Doctor?
  pharmacyMemberships         PharmacyStaff[]
  clinicMemberships           ClinicStaff[]
  createdAppointments         Appointment[]                  @relation("AppointmentCreator")
  refreshTokens               RefreshToken[]
  notifications               Notification[]
  aiConversations             AiConversation[]
  payments                    Payment[]
  grantedPrescriptionAccesses PrescriptionAccess[]           @relation("PrescriptionAccessGrantor")
  requestedReservations       StockReservation[]             @relation("ReservationRequester")
  reviewedDoctors             Doctor[]                       @relation("DoctorReviewer")
  reviewedDoctorDocuments     DoctorVerificationDocument[]   @relation("DoctorDocumentReviewer")
  reviewedClinics             Clinic[]                       @relation("ClinicReviewer")
  reviewedPharmacies          Pharmacy[]                     @relation("PharmacyReviewer")
  reviewedPharmacyDocuments   PharmacyVerificationDocument[] @relation("PharmacyDocumentReviewer")
  uploadedFiles               FileUpload[]                   @relation("FileUploader")
  auditLogs                   AuditLog[]                     @relation("AuditActor")

  @@index([role, status])
  @@index([status, deletedAt])
  @@index([lockedUntil])
  @@index([deletionRequestedAt])
  @@map("users")
}

model Wilaya {
  id        Int      @id @default(autoincrement())
  code      Int      @unique
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  communes Commune[]

  @@map("wilayas")
}

model Commune {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  wilayaId  Int      @map("wilaya_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wilaya     Wilaya     @relation(fields: [wilayaId], references: [id], onDelete: Restrict)
  patients   Patient[]
  clinics    Clinic[]
  pharmacies Pharmacy[]

  @@unique([wilayaId, name])
  @@index([wilayaId])
  @@map("communes")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(50)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}
